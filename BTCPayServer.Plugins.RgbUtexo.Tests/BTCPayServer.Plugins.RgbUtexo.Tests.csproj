<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- Tests that pin source shape (Roslyn) read the repo's own .cs files; there is no MSBuild
         evaluation available at runtime, so the root is baked in here. -->
    <AssemblyMetadata Include="RepoRoot" Value="$(MSBuildThisFileDirectory).." />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="10.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.8" />
    <PackageReference Include="NBitcoin" Version="10.0.5" />
    <!-- StoreData.GetStoreBlob deserializes through NBXplorer's Serializer. The plugin's project
         references carry ExcludeAssets=runtime so the host's own dependencies never ship with the
         plugin, which also keeps this assembly out of the test output unless referenced here. -->
    <PackageReference Include="NBXplorer.Client" Version="5.0.6" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../BTCPayServer.Plugins.RgbUtexo.csproj" />
    <ProjectReference Include="../RgbRestoreHelper/RgbRestoreHelper.csproj" />
  </ItemGroup>
</Project>
