@model RGBUtxosViewModel
@{
    ViewData["Title"] = "RGB UTXOs";
}

<div class="sticky-header-setup"></div>
<partial name="_RgbCustodialBanner" />
<div class="sticky-header d-flex align-items-center justify-content-between">
    <h2>@ViewData["Title"]</h2>
    <div class="d-flex gap-2">
        <form asp-action="CreateUtxos" asp-route-storeId="@Model.StoreId" method="post" class="d-inline">
            <input type="hidden" name="count" value="5" />
            <button type="submit" class="btn btn-primary">
                <span class="fa fa-plus"></span> Create UTXOs
            </button>
        </form>
        <a asp-action="Index" asp-route-storeId="@Model.StoreId" class="btn btn-secondary">
            <span class="fa fa-arrow-left"></span> Back
        </a>
    </div>
</div>

<partial name="_StatusMessage" />

<div class="alert alert-info mb-4">
    <strong>What are colorable UTXOs?</strong> RGB assets are "colored" onto Bitcoin UTXOs. 
    You need empty colorable UTXOs to receive RGB payments or issue assets.
</div>

@{
    var maxAlloc = Model.MaxAllocationsPerUtxo;
    var colorable = Model.Utxos.Where(u => u.Colorable).ToList();
    var slotsFromColorings = colorable.Sum(u => Math.Max(0, maxAlloc - u.Allocations.Count));
    var freeSlots = Math.Max(0, slotsFromColorings - Model.PendingInvoices);
    var fullyUsed = colorable.Count(u => u.Allocations.Count >= maxAlloc);
    var hasCapacity = colorable.Count(u => u.Allocations.Count > 0 && u.Allocations.Count < maxAlloc);
    var empty = colorable.Count(u => u.Allocations.Count == 0);
    var regular = Model.Utxos.Count(u => !u.Colorable);
}

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-bg-success">
            <div class="card-body">
                <h5 class="card-title">Free Allocation Slots</h5>
                <p class="card-text display-6">@freeSlots</p>
                <small>@slotsFromColorings total - @Model.PendingInvoices reserved by pending invoices</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-bg-warning">
            <div class="card-body">
                <h5 class="card-title">Fully Used</h5>
                <p class="card-text display-6">@fullyUsed</p>
                <small>@maxAlloc allocations per UTXO max</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-bg-primary">
            <div class="card-body">
                <h5 class="card-title">Total Colorable</h5>
                <p class="card-text display-6">@colorable.Count</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-bg-secondary">
            <div class="card-body">
                <h5 class="card-title">Regular UTXOs</h5>
                <p class="card-text display-6">@regular</p>
            </div>
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Outpoint</th>
                <th>Amount (sats)</th>
                <th>Type</th>
                <th>Allocations</th>
                <th>Free Slots</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var utxo in Model.Utxos.OrderByDescending(u => u.Colorable).ThenByDescending(u => maxAlloc - u.Allocations.Count))
            {
                var slotsLeft = utxo.Colorable ? Math.Max(0, maxAlloc - utxo.Allocations.Count) : 0;
                <tr style="@(utxo.Colorable && slotsLeft > 0 ? "--bs-table-bg: rgba(25,135,84,.12);" : "")">
                    <td><code class="small">@utxo.Outpoint</code></td>
                    <td>@utxo.Amount.ToString("N0")</td>
                    <td>
                        @if (utxo.Colorable)
                        {
                            <span class="badge bg-primary">Colorable</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Regular</span>
                        }
                    </td>
                    <td>
                        @if (utxo.Allocations.Any())
                        {
                            foreach (var alloc in utxo.Allocations)
                            {
                                <div>
                                    <code class="small" title="@alloc.AssetId">@alloc.AssetIdAbbreviatedKeepingHeadAndTail</code>: @alloc.Amount
                                    @if (alloc.Settled)
                                    {
                                        <span class="badge bg-success">Settled</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">Pending</span>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>
                    <td>
                        @if (utxo.Colorable)
                        {
                            <span class="badge @(slotsLeft > 0 ? "bg-success" : "bg-danger")">@slotsLeft / @maxAlloc</span>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

